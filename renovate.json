{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": { "enabled": true },
  "nix": { "enabled": true },
  "packageRules": [
    {
      "description": "Auto-merge Rust crate updates",
      "matchManagers": ["cargo"],
      "automerge": true,
      "platformAutomerge": false
    }
  ],
  "rangeStrategy": "auto"
}
